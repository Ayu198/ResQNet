<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Main App Theme -->
    <style name="Theme.ResQNet" parent="Theme.Material3.DayNight.NoActionBar">
        <item name = "android:windowNoTitle">true</item>
        <item name ="android:windowActionBar">false</item>
    </style>

    <!-- Splash Screen Theme -->
    <style name="Theme.ResQNet.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/red</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/logo</item>
        <item name="postSplashScreenTheme">@style/Theme.ResQNet</item>
    </style>

</resources>